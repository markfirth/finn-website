OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Agent routing config (start with one live agent)
FINN_EXECUTIVE_PROVIDER=openai
FINN_EXECUTIVE_OPENAI_MODEL=gpt-4.1-mini
FINN_EXECUTIVE_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Supabase server-side persistence
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_CHAT_TABLE=finn_agent_messages

PORT=3000
